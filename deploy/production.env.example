# =============================================================================
# AETHERION PRODUCTION DEPLOYMENT ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# WARNING: NEVER commit a populated .env file to version control.
# Generate high-entropy secrets using:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Environment Identity ---
ENVIRONMENT=production
AETHERION_ENV=production
AETHERION_RELEASE_SCOPE=control-plane
AETHERION_EXECUTION_DISABLED=1
RUNNER_CONTAINER=1

# --- Public Network & Reverse Proxy Binding ---
HOST=0.0.0.0
PORT=5000
# SERVER_URL MUST be a public HTTPS URL in production (e.g., https://api.aetherion.ai).
# Insecure HTTP or localhost values strictly fail preflight startup checks.
SERVER_URL=https://api.aetherion.ai
FRONTEND_URL=https://app.aetherion.ai
ALLOWED_ORIGINS=https://app.aetherion.ai,https://aetherion.ai

# --- Cryptographic Application Security ---
# SECRET_KEY and JWT_SECRET MUST be independent, 64-character hexadecimal secrets (32+ bytes entropy).
# Reusing the same value for both secrets will trigger a CRITICAL preflight failure.
SECRET_KEY=REPLACE_WITH_INDEPENDENT_64_CHAR_HEX_SECRET_KEY
JWT_SECRET=REPLACE_WITH_INDEPENDENT_64_CHAR_HEX_JWT_SECRET
DEVICE_CODE_TTL_SECS=900
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Authoritative PostgreSQL Database ---
# SQLite is strictly blocked in production. PostgreSQL connection is mandatory.
POSTGRES_DB=aetherion
POSTGRES_USER=aetherion_user
POSTGRES_PASSWORD=REPLACE_WITH_64_CHAR_HEX_POSTGRES_PASSWORD
DATABASE_URL=postgresql://aetherion_user:REPLACE_WITH_SECURE_POSTGRES_PASSWORD@postgres:5432/aetherion
DB_POOL_MIN=5
DB_POOL_MAX=20

# --- Distributed Coordination & Task Queue (Redis) ---
# Mandatory for multi-worker task orchestration, token revocation blacklist, and SSE events.
REDIS_URL=redis://redis:6379/0

# --- Execution scope ---------------------------------------------------------
# Autonomous agent, command, plugin, worker, and physical worktree execution
# are disabled in the approved control-plane release. A future execution-enabled
# release must separately define its trusted supervisor, governance package, and
# sandbox contract; do not add those toggles here to enable execution.

# --- Third-Party OAuth Identity Providers ---
# Register these redirect URIs in Google Cloud Console & GitHub Developer Settings:
#   Google: https://api.aetherion.ai/api/auth/google/callback
#   GitHub: https://api.aetherion.ai/api/auth/github/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET

# --- AI Model Providers (not required while execution is disabled) ------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Local image names used by deploy/deploy.ps1 and deploy/deploy.sh -------
# Replace with immutable registry references for a remote production rollout.
AETHERION_BACKEND_IMAGE=aetherion-backend:local
AETHERION_WORKER_IMAGE=aetherion-worker:local
AETHERION_FRONTEND_AUTH_IMAGE=aetherion-frontend-auth:local
